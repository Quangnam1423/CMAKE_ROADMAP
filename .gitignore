# =====================================
# GENERAL BUILD ARTIFACTS
# =====================================
# Build directories
/build/
/bin/
/out/
/dist/
/target/
/lib/
/obj/
/CMakeFiles/

# Compiled object files
*.o
*.obj
*.lo
*.slo

# Ignore all executables with no extension
*
!*/
!*.*

# Compiled dynamic libraries
*.so
*.dylib
*.dll

# Compiled static libraries
*.a
*.lib
*.la

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# =====================================
# CMAKE
# =====================================
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
Testing/

# =====================================
# IDE / EDITOR FILES
# =====================================

# Visual Studio / VS Code
.vscode/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# CLion / JetBrains
.idea/
cmake-build-*/

# Eclipse CDT
.project
.cproject
.settings/

# Code::Blocks
*.layout
*.cbp
*.depend
*.depend.*

# Dev-C++
*.dev

# =====================================
# OS / TEMP FILES
# =====================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
*.swp
*.swo
.cache/
*.tmp
*.log

# =====================================
# PACKAGE / TOOL FILES
# =====================================
# Conan
conanbuildinfo.txt
conaninfo.txt
conan.lock

# Vcpkg
vcpkg_installed/

# Ninja
.ninja_deps
.ninja_log

# =====================================
# EXTERNAL LIBRARIES
# =====================================
# If you fetch dependencies like GLFW, GLAD, etc. dynamically,
# you may want to ignore them:
external/*/build/
external/*/bin/
external/*/lib/
external/*/CMakeFiles/